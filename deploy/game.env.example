SITE_ADDRESS=game.example.com
PUBLIC_ORIGIN=https://game.example.com
REGIONS=eu
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_SECRET=replace-with-the-relay-shared-secret
METRICS_TOKEN=replace-with-a-separate-random-secret

# Container budgets; leave headroom above the Go soft memory limit.
APP_MEMORY_LIMIT=512m
APP_GO_MEMORY_LIMIT=384MiB
APP_CPUS=2.0
