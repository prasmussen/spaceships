          (if (i32.eqz (i32.load offset=32 (local.get $p))) (then (i32.store offset=48 (local.get $p) (i32.const 0))))
          (local.set $id (i32.add (local.get $id) (i32.const 1)))
          (br_if $fly (i32.lt_u (local.get $id) (call $players))))
        (call $ship_contact)
        (call $debris_step)
        (call $projectiles)
        (local.set $substep (i32.add (local.get $substep) (i32.const 1)))
        (br_if $substeps (i32.lt_u (local.get $substep) (i32.const 2))))
      (call $finish_combat)
      (i32.store (i32.const 4096) (i32.add (i32.load (i32.const 4096)) (i32.const 1)))
      (local.set $input (i32.add (local.get $input) (call $players)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $ticks))) (i32.const 1))
  (func (export "save_state") (param $dst i32) (result i32)
    (if (i32.ne (local.get $dst) (i32.const 65536)) (then (return (i32.const 0))))
    (memory.copy (local.get $dst) (i32.const 4096) (i32.const 8512)) (i32.const 8512))
  (func (export "load_state") (param $src i32) (param $length i32) (result i32)
    (local $p i32) (local $i i32) (local $pad i32) (local $winner i32) (local $a i32) (local $b i32) (local $other i32)
    (if (i32.or (i32.ne (local.get $src) (i32.const 65536)) (i32.ne (local.get $length) (i32.const 8512))) (then (return (i32.const 0))))
    (if (i32.or (i32.gt_u (i32.load (local.get $src)) (i32.const 2147483527))
