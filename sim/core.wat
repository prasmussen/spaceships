(module
  ;; Fixed memory: ABI 0, config 1024, inputs 2048, state 4096 (8512 bytes),
  ;; snapshot staging 65536, frame 81920, checked-in trigonometry 16384.
  (memory (export "memory") 4 4)
  (data (i32.const 0) "CDUL\02\00\00\00\00\10\00\00\40\21\00\00\00\08\00\00\00\00\01\00\00\40\01\00\04\00\00\00")
  ;; MAP_DATA
  ;; EVENTS
  ;; DEBRIS
  ;; DEBRIS_DATA
  ;; EXHAUST
  ;; COMBAT
  ;; COLLISION
  ;; LANDING
  ;; CONFIG_DATA
  ;; TRIG_TABLE
  (func (export "abi_info") (result i32) (i32.const 0))
  ;; All divisions truncate toward zero. Products widen before division.
  (func $mul (param $a i32) (param $b i32) (result i32)
    (i32.wrap_i64 (i64.div_s (i64.mul (i64.extend_i32_s (local.get $a)) (i64.extend_i32_s (local.get $b))) (i64.const 65536))))
  (func $clamp (param $v i32) (param $max i32) (result i32)
    (if (result i32) (i32.gt_s (local.get $v) (local.get $max)) (then (local.get $max))
      (else (if (result i32) (i32.lt_s (local.get $v) (i32.sub (i32.const 0) (local.get $max)))
        (then (i32.sub (i32.const 0) (local.get $max))) (else (local.get $v))))))
  (func $sin (param $a i32) (result i32)
    (i32.load (i32.add (i32.const 16384) (i32.shl (i32.and (local.get $a) (i32.const 4095)) (i32.const 2)))))
  (func $players (result i32) (i32.load (i32.const 4116)))
  (func $ship (param $id i32) (result i32) (i32.add (i32.const 4160) (i32.mul (local.get $id) (i32.const 64))))
  (func $old (param $id i32) (result i32) (i32.add (i32.const 40032) (i32.mul (local.get $id) (i32.const 8))))
  (func $crash_ptr (param $id i32) (result i32) (i32.add (i32.const 40016) (i32.mul (local.get $id) (i32.const 4))))
  (func (export "init") (param $config i32) (param $map i32) (param $seed i32) (param $players i32) (result i32)
    (local $id i32) (local $p i32)
    (if (i32.or (i32.lt_u (local.get $players) (i32.const 1)) (i32.gt_u (local.get $players) (i32.const 4))) (then (return (i32.const 0))))
    ;; Map 0 is the unbounded test world; 32768 is cave, 32769 is the arena.
    (if (i32.or (i32.ne (local.get $config) (i32.const 1024)) (i32.and (i32.ne (local.get $map) (i32.const 0)) (i32.or (i32.lt_u (local.get $map) (i32.const 32768)) (i32.gt_u (local.get $map) (i32.const 32769))))) (then (return (i32.const 0))))
    ;; CONFIG_VALIDATE
    ;; MAP_VALIDATE
    (i32.store (i32.const 131072) (i32.const 0))
    (memory.fill (i32.const 4096) (i32.const 0) (i32.const 8512))
    (i32.store (i32.const 4100) (i32.const -1))
    (i32.store (i32.const 4112) (local.get $seed))
    (i32.store (i32.const 4116) (local.get $players))
    (if (local.get $map) (then (i32.store (i32.const 4104) (i32.sub (local.get $map) (i32.const 32767)))))
    (loop $initialize_ships
      (local.set $p (call $ship (local.get $id)))
      (call $spawn (local.get $p))
      (if (i32.eqz (local.get $map)) (then (i32.store offset=48 (local.get $p) (i32.const 0))))
      (local.set $id (i32.add (local.get $id) (i32.const 1)))
      (br_if $initialize_ships (i32.lt_u (local.get $id) (call $players))))
    (i32.const 1))
  ;; Boost timers and edge latch are snapshot state, shared by rollback and replays.
  (func $aux (param $p i32) (result i32)
    (i32.add (i32.const 4120) (i32.div_u (i32.sub (local.get $p) (i32.const 4160)) (i32.const 8))))
  (func $shield_tick (param $p i32) (param $buttons i32)
    (local $a i32) (local $pressed i32)
    (local.set $a (call $aux (local.get $p)))
    (i32.store8 (local.get $a) (call $max (i32.const 0) (i32.sub (i32.load8_u (local.get $a)) (i32.const 1))))
    (i32.store8 offset=1 (local.get $a) (call $max (i32.const 0) (i32.sub (i32.load8_u offset=1 (local.get $a)) (i32.const 1))))
    (i32.store16 offset=2 (local.get $a) (call $max (i32.const 0) (i32.sub (i32.load16_u offset=2 (local.get $a)) (i32.const 1))))
    (i32.store16 offset=4 (local.get $a) (call $max (i32.const 0) (i32.sub (i32.load16_u offset=4 (local.get $a)) (i32.const 1))))
    (local.set $pressed (i32.ne (i32.and (local.get $buttons) (i32.const 32)) (i32.const 0)))
    (if (i32.and (local.get $pressed) (i32.eqz (i32.load8_u offset=6 (local.get $a)))) (then
      (if (i32.and (i32.eqz (i32.load16_u offset=2 (local.get $a)))
        (i32.and (i32.gt_s (i32.load offset=28 (local.get $p)) (i32.const 0))
          (i32.ge_s (i32.load offset=24 (local.get $p)) (i32.const @shieldEnergyCost@)))) (then
        (i32.store8 (local.get $a) (i32.const @shieldDuration@))
        (i32.store16 offset=2 (local.get $a) (i32.const @shieldCooldown@))
        (i32.store offset=24 (local.get $p) (i32.sub (i32.load offset=24 (local.get $p)) (i32.const @shieldEnergyCost@)))))))
    (i32.store8 offset=6 (local.get $a) (local.get $pressed)))
  (func $repair (param $p i32)
    (if (i32.and (i32.load offset=32 (local.get $p)) (i32.and
      (i32.gt_s (i32.load offset=28 (local.get $p)) (i32.const 0))
      (i32.eqz (i32.load16_u offset=4 (call $aux (local.get $p)))))) (then
      (i32.store offset=28 (local.get $p) (call $min (i32.const @hull@) (i32.add (i32.load offset=28 (local.get $p)) (i32.const 1)))))))
  (func $boost_tick (param $p i32) (param $buttons i32)
    (local $pressed i32)
    (i32.store offset=52 (local.get $p) (call $max (i32.const 0) (i32.sub (i32.load offset=52 (local.get $p)) (i32.const 1))))
    (i32.store offset=56 (local.get $p) (call $max (i32.const 0) (i32.sub (i32.load offset=56 (local.get $p)) (i32.const 1))))
    (local.set $pressed (i32.ne (i32.and (local.get $buttons) (i32.const 16)) (i32.const 0)))
    (if (i32.and (local.get $pressed) (i32.eqz (i32.load offset=60 (local.get $p)))) (then
      (if (i32.and (i32.eqz (i32.load offset=56 (local.get $p)))
        (i32.and (i32.gt_s (i32.load offset=28 (local.get $p)) (i32.const 0))
          (i32.gt_s (i32.load offset=24 (local.get $p)) (i32.const @boostFuelCost@)))) (then
        (i32.store offset=52 (local.get $p) (i32.const @boostDuration@))
        (i32.store offset=56 (local.get $p) (i32.const @boostCooldown@))
        (i32.store offset=24 (local.get $p) (i32.sub (i32.load offset=24 (local.get $p)) (i32.const @boostFuelCost@)))))))
    (i32.store offset=60 (local.get $p) (local.get $pressed)))
  (func $thrust_buttons (param $p i32) (param $buttons i32) (result i32)
    (i32.or (local.get $buttons) (i32.gt_s (i32.load offset=52 (local.get $p)) (i32.const 0))))
  (func $flight (param $p i32) (param $buttons i32) (param $substep i32)
    (local $spin i32) (local $angle i32) (local $vx i32) (local $vy i32) (local $fuel i32) (local $push i32) (local $pad i32)
    (local.set $buttons (call $thrust_buttons (local.get $p) (local.get $buttons)))
    (if (i32.or (i32.eqz (i32.load offset=28 (local.get $p)))
      (i32.load (i32.add (i32.const 40016) (i32.mul (i32.div_u (i32.sub (local.get $p) (i32.const 4160)) (i32.const 64)) (i32.const 4))))) (then (return)))
    (if (i32.load offset=32 (local.get $p)) (then
      (local.set $push (i32.load (i32.add (i32.const 40136) (i32.div_u (i32.sub (local.get $p) (i32.const 4160)) (i32.const 16)))))
      ;; Sliding carries momentum after the exhaust passes, with pad friction.
      (local.set $push (call $clamp (i32.add (local.get $push) (i32.load offset=8 (local.get $p))) (i32.const 98304)))
      (local.set $push (call $mul (local.get $push) (i32.const 63488)))
      (i32.store offset=8 (local.get $p) (local.get $push))
      (if (local.get $push) (then
        (call $move (local.get $p) (i32.div_s (local.get $push) (i32.const 2)) (i32.const 0))
        (local.set $pad (call $pad_at (i32.load (local.get $p)) (i32.load offset=4 (local.get $p))))
        (if (i32.eqz (local.get $pad)) (then
          (i32.store offset=32 (local.get $p) (i32.const 0))
          (i32.store offset=8 (local.get $p) (local.get $push))))))))
    (if (i32.load offset=32 (local.get $p)) (then
      (if (i32.and (i32.and (local.get $buttons) (i32.const 1)) (i32.gt_s (i32.load offset=24 (local.get $p)) (i32.const 0)))
        (then (i32.store offset=32 (local.get $p) (i32.const 0)))
        (else (i32.store offset=24 (local.get $p) (call $min (i32.const @fuelCapacity@) (i32.add (i32.load offset=24 (local.get $p)) (i32.const @refuelPerSubstep@)))) (return)))))
    (local.set $spin (i32.load offset=20 (local.get $p)))
    (local.set $spin (call $clamp (i32.add (local.get $spin)
      (i32.mul (i32.sub (i32.ne (i32.and (local.get $buttons) (i32.const 4)) (i32.const 0))
        (i32.ne (i32.and (local.get $buttons) (i32.const 2)) (i32.const 0))) (i32.const @angularAccelerationPerSubstep@))) (i32.const @maxAngularSpeed@)))
    ;; Neutral steering brakes toward zero without reversing or consuming fuel.
    (if (i32.eq (i32.ne (i32.and (local.get $buttons) (i32.const 2)) (i32.const 0))
      (i32.ne (i32.and (local.get $buttons) (i32.const 4)) (i32.const 0))) (then
      (local.set $spin (i32.sub (local.get $spin) (call $clamp (local.get $spin) (i32.const @angularBrakingPerSubstep@))))))
    (local.set $angle (i32.and (i32.add (i32.load offset=16 (local.get $p)) (i32.div_s (local.get $spin) (i32.const 2))) (i32.const 4095)))
    (local.set $vx (i32.load offset=8 (local.get $p)))
    (local.set $vy (i32.load offset=12 (local.get $p)))
    (local.set $fuel (i32.load offset=24 (local.get $p)))
    ;; Gentle coasting drag, independent of rotation braking and without fuel use.
    (if (i32.eqz (i32.and (i32.and (local.get $buttons) (i32.const 1)) (i32.gt_s (local.get $fuel) (i32.const 0)))) (then
      (local.set $vx (i32.sub (local.get $vx) (i32.div_s (local.get $vx) (i32.const @movementDragDivisor@))))
      (local.set $vy (i32.sub (local.get $vy) (i32.div_s (local.get $vy) (i32.const @movementDragDivisor@))))))
    (local.set $vy (i32.add (local.get $vy) (i32.const @gravityPerSubstep@)))
    (if (i32.and (i32.and (local.get $buttons) (i32.const 1)) (i32.gt_s (local.get $fuel) (i32.const 0))) (then
      (local.set $vx (i32.add (local.get $vx) (call $mul (call $sin (local.get $angle)) (if (result i32) (i32.load offset=52 (local.get $p)) (then (i32.const @boostThrustPerSubstep@)) (else (i32.const @thrustPerSubstep@))))))
      (local.set $vy (i32.sub (local.get $vy) (call $mul (call $sin (i32.add (local.get $angle) (i32.const 1024))) (if (result i32) (i32.load offset=52 (local.get $p)) (then (i32.const @boostThrustPerSubstep@)) (else (i32.const @thrustPerSubstep@))))))
      ;; Normal thrust pays once per tick, after its second half-step.
      ;; Boost retains its existing per-substep energy cost.
      (local.set $fuel (i32.sub (local.get $fuel) (i32.or (local.get $substep)
        (i32.gt_s (i32.load offset=52 (local.get $p)) (i32.const 0)))))))
    (local.set $vx (call $clamp (local.get $vx) (i32.const @maxSpeed@)))
    (local.set $vy (call $clamp (local.get $vy) (i32.const @maxSpeed@)))
    (i32.store offset=8 (local.get $p) (local.get $vx))
    (i32.store offset=12 (local.get $p) (local.get $vy))
    (i32.store offset=16 (local.get $p) (local.get $angle))
    (i32.store offset=20 (local.get $p) (local.get $spin))
    (i32.store offset=24 (local.get $p) (local.get $fuel))
    (if (i32.load (i32.const 4104))
      (then (call $move (local.get $p) (i32.div_s (local.get $vx) (i32.const 2)) (i32.div_s (local.get $vy) (i32.const 2))))
      (else
    (i32.store (local.get $p) (call $clamp (i32.add (i32.load (local.get $p)) (i32.div_s (local.get $vx) (i32.const 2))) (i32.const @maxPosition@)))
    (i32.store offset=4 (local.get $p) (call $clamp (i32.add (i32.load offset=4 (local.get $p)) (i32.div_s (local.get $vy) (i32.const 2))) (i32.const @maxPosition@)))
)))

  (func (export "step") (param $input i32) (param $count i32) (result i32)
    (local $i i32) (local $id i32) (local $other i32) (local $p i32) (local $substep i32)
    (if (i32.or (i32.ne (local.get $input) (i32.const 2048)) (i32.gt_u (local.get $count) (i32.const 120))) (then (return (i32.const 0))))
    (if (i32.gt_u (i32.add (i32.load (i32.const 4096)) (local.get $count)) (i32.const 2147483527)) (then (return (i32.const 0))))
    (block $done (loop $ticks
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (br_if $done (i32.ne (i32.load (i32.const 4100)) (i32.const -1)))
      (i32.store (i32.const 131072) (i32.const 0))
      (memory.fill (i32.const 40000) (i32.const 0) (i32.const 32))
      (memory.fill (i32.const 40160) (i32.const 255) (i32.const 16))
      (i32.store (i32.const 40132) (i32.const 0))
      (local.set $id (i32.const 0))
      (loop $prepare
        (local.set $p (call $ship (local.get $id)))
