    (if (i32.gt_u (i32.load16_u offset=4 (i32.add (local.get $src) (i32.const 24))) (i32.const @repairDelay@)) (then (return (i32.const 0))))
    (if (i32.gt_u (i32.load8_u offset=6 (i32.add (local.get $src) (i32.const 24))) (i32.const 1)) (then (return (i32.const 0))))
    (if (i32.gt_u (i32.load8_u offset=7 (i32.add (local.get $src) (i32.const 24))) (i32.const 0)) (then (return (i32.const 0))))
    (if (i32.le_u (call $players) (i32.const 0)) (then (if (i64.ne (i64.load (i32.add (local.get $src) (i32.const 24))) (i64.const 0)) (then (return (i32.const 0))))))
    (if (i32.gt_u (i32.load8_u offset=0 (i32.add (local.get $src) (i32.const 32))) (i32.const @shieldDuration@)) (then (return (i32.const 0))))
