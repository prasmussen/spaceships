        (local.set $id (i32.const 0))
        (loop $emitters
          (local.set $other (i32.const 0))
          (loop $targets
            (if (i32.ne (local.get $id) (local.get $other)) (then
              (call $exhaust_force (call $ship (local.get $id)) (call $ship (local.get $other)) (i32.load8_u (i32.add (local.get $input) (local.get $id))))))
            (local.set $other (i32.add (local.get $other) (i32.const 1)))
            (br_if $targets (i32.lt_u (local.get $other) (call $players))))
          (local.set $id (i32.add (local.get $id) (i32.const 1)))
          (br_if $emitters (i32.lt_u (local.get $id) (call $players))))
        (call $capture_positions)
        (local.set $id (i32.const 0))
        (loop $fly
